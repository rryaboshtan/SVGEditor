# Long-lived cache for hashed-static-like assets (Cloudflare Pages / compatible hosts)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/app.min.js
  Cache-Control: public, max-age=604800

/embed.min.js
  Cache-Control: public, max-age=604800

/styles.min.css
  Cache-Control: public, max-age=604800

/fonts.min.css
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

# HTML stays fresher + CSP (frame-ancestors only works via HTTP header, not <meta>)
/
  Cache-Control: public, max-age=300
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=300
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self'; form-action 'none'; upgrade-insecure-requests; frame-ancestors 'none'

/embed.html
  Cache-Control: public, max-age=300
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src data: blob: https:; connect-src 'self'; form-action 'none'; upgrade-insecure-requests

/*.html
  Cache-Control: public, max-age=300
